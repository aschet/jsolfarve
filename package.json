{
  "name": "olfarve",
  "version": "1.0.0",
  "description": "sRGB color rendering of SRM/EBC beer color values",
  "keywords": [
    "beer",
    "brewing",
    "color",
    "colour",
    "srm",
    "ebc",
    "srgb",
    "colorimetry"
  ],
  "homepage": "https://github.com/aschet/olfarvejs#readme",
  "bugs": "https://github.com/aschet/olfarvejs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aschet/olfarvejs.git"
  },
  "license": "MIT",
  "author": "Thomas Ascher <thomas.ascher@gmx.at>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "olfarve": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run build && npm run lint:package && npm run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:package": "publint --strict && attw --pack .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
